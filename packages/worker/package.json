{
  "name": "@synergilon/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "run-once": "tsx src/index.ts --once",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "ingest-ads": "tsx src/index.ts --once --job ingest-ads",
    "ingest-stores": "tsx src/index.ts --once --job ingest-stores"
  },
  "dependencies": {
    "@synergilon/db": "workspace:*",
    "pg-boss": "^12.29.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.19.0",
    "eslint": "^9.39.5",
    "tsx": "^4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  }
}
