generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Auth.js (v5) models. Shape follows @auth/prisma-adapter's expectations.
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  credits       Int       @default(100)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts   Account[]
  sessions   Session[]
  folders    Folder[]
  savedItems SavedItem[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@index([userId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ---------------------------------------------------------------------------
// Domain models
// ---------------------------------------------------------------------------

model Store {
  id             String    @id @default(cuid())
  shopifyDomain  String    @unique
  name           String
  description    String?
  logo           String?
  category       String
  /// Mock-only measured figures. Null for live stores: nothing public exposes them.
  monthlyRevenue Float?
  monthlyTraffic Int?
  /// Storefront-derived estimate (see sources/shopify/estimate.ts) with its confidence: none | low | medium.
  revenueEstimate    Float?
  estimateConfidence String?
  /// Observable storefront signals.
  productCount    Int?
  /// True when the catalogue crawl hit the hard page cap; the UI shows "10,000+".
  productCountTruncated Boolean @default(false)
  priceMin        Float?
  priceMax        Float?
  currency        String?
  /// "mock" (seed) or "shopify_storefront" (ingestion).
  source          String    @default("mock")
  sourceUpdatedAt DateTime?
  /// Raw <title>; the display name is resolved separately (og:site_name, ld+json, ...).
  pageTitle       String?
  /// Raw product_type values and tags from the storefront, most common first.
  rawTags         String[]  @default([])
  topProduct     Json?
  techStack      Json?
  lastScrapedAt  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Generated tsvector over name + description. Prisma can't express
  // `GENERATED ALWAYS AS (...) STORED`, so the column is declared here as
  // Unsupported (keeps migrate diffing honest) and the generation expression
  // lives in the hand-written migration `*_fulltext_search`.
  searchVector Unsupported("tsvector")?

  snapshots StoreSnapshot[]
  ads       Ad[]

  @@index([monthlyRevenue])
  @@index([category])
  @@index([source])
  @@index([searchVector], type: Gin)
}

model StoreSnapshot {
  id             String   @id @default(cuid())
  storeId        String
  /// Mock drift values; null for live snapshots.
  monthlyRevenue Float?
  monthlyTraffic Int?
  /// Observable signals captured by the storefront ingestion.
  productCount    Int?
  priceMin        Float?
  priceMax        Float?
  revenueEstimate Float?
  /// "mock" | "shopify_storefront"
  source         String?
  capturedAt     DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, capturedAt])
}

enum AdPlatform {
  META
  TIKTOK
  GOOGLE
}

model Ad {
  id             String     @id @default(cuid())
  platform       AdPlatform
  creativeUrl    String
  headline       String
  bodyText       String
  cta            String
  /// Mock-only metrics. The Ad Library does not expose spend or engagement
  /// for commercial ads, so these are null for live rows — never estimated.
  spendEstimate  Float?
  impressions    Int?
  engagementRate Float?
  /// Ad Library impression range (political/issue ads only) and EU reach.
  impressionsLower Int?
  impressionsUpper Int?
  euTotalReach     Int?
  targetAudience Json?
  /// Live ads may not map to a tracked store; then pageId/pageName identify the advertiser.
  storeId        String?
  pageId         String?
  pageName       String?
  /// Meta Ad Library archive id (unique) and delivery window as reported.
  adLibraryId    String?    @unique
  firstSeenAt    DateTime?
  lastSeenAt     DateTime?
  /// False once an ad stops appearing in the archive; rows are never deleted.
  active         Boolean    @default(true)
  /// "mock" | "meta_ad_library"
  source         String     @default("mock")
  /// Raw provider payload for debugging and re-mapping.
  raw            Json?
  createdAt      DateTime   @default(now())

  // See Store.searchVector — same approach, over headline + bodyText.
  searchVector Unsupported("tsvector")?

  store Store? @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([platform])
  @@index([engagementRate])
  @@index([source, active])
  @@index([lastSeenAt])
  @@index([pageId])
  @@index([searchVector], type: Gin)
}

// ---------------------------------------------------------------------------
// Ingestion
// ---------------------------------------------------------------------------

enum TrackedKind {
  STORE
  BRAND
}

/// Work list for the ingestion jobs: a Shopify domain (STORE) or a Meta page id (BRAND).
model TrackedEntity {
  id            String      @id @default(cuid())
  kind          TrackedKind
  /// Domain (STORE) or Meta page id (BRAND).
  value         String
  /// Human label, e.g. the brand name.
  label         String?
  /// For BRAND entities: the store domain whose ads these are (links Ad.storeId).
  linkedDomain  String?
  addedByUserId String?
  active        Boolean     @default(true)
  /// Why it was deactivated automatically (e.g. not a Shopify storefront).
  inactiveReason String?
  /// Set when the site answers 403 persistently; skipped until this time.
  blockedUntil  DateTime?
  blockedReason String?
  /// Consecutive failed runs; reset on success.
  failCount     Int         @default(0)
  lastRunAt     DateTime?
  lastError     String?
  createdAt     DateTime    @default(now())

  @@unique([kind, value])
  @@index([active])
}

enum IngestSource {
  META_AD_LIBRARY
  SHOPIFY_STOREFRONT
}

enum IngestStatus {
  RUNNING
  SUCCESS
  FAILED
  PARTIAL
}

/// One row per ingestion run, for operational visibility (/ingest).
model IngestRun {
  id           String       @id @default(cuid())
  source       IngestSource
  status       IngestStatus @default(RUNNING)
  startedAt    DateTime     @default(now())
  finishedAt   DateTime?
  itemsSeen    Int          @default(0)
  itemsWritten Int          @default(0)
  error        String?
  /// Free-form details (per-entity counts, skipped items).
  details      Json?

  @@index([source, startedAt])
}

// ---------------------------------------------------------------------------
// Folders & saved items
// ---------------------------------------------------------------------------

model Folder {
  id        String   @id @default(cuid())
  name      String
  parentId  String?
  userId    String
  createdAt DateTime @default(now())

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent     Folder?     @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children   Folder[]    @relation("FolderTree")
  savedItems SavedItem[]

  @@unique([userId, parentId, name])
  @@index([userId])
}

enum SavedItemType {
  STORE
  AD
}

model SavedItem {
  id        String        @id @default(cuid())
  userId    String
  folderId  String
  itemType  SavedItemType
  itemId    String
  notes     String?
  createdAt DateTime      @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder Folder @relation(fields: [folderId], references: [id], onDelete: Cascade)

  @@unique([userId, folderId, itemType, itemId])
  @@index([userId])
}
