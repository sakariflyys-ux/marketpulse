# ---------------------------------------------------------------------------
# Synergilon environment. Copy to `.env` at the repo root. Every package
# (web, db, worker, mcp-server) reads the same file.
# ---------------------------------------------------------------------------

# --- Database (required) ---------------------------------------------------
# Local: matches docker-compose.yml.
# Neon/Supabase: use the pooled URL, e.g.
#   postgresql://<user>:<password>@<host>/<db>?sslmode=require
# then run `pnpm db:deploy && pnpm db:seed`.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/marketpulse?schema=public"

# --- Seeding ---------------------------------------------------------------
# small (default): 100 stores / 500 ads. large: 10,000 stores / 50,000 ads.
SEED_SCALE=small

# --- Auth.js ---------------------------------------------------------------
# Required in production; optional in development (a dev secret is used).
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Only needed when the app is served behind a proxy or on a non-localhost URL.
AUTH_URL=
# Set to "true" when deploying behind a reverse proxy (Auth.js trusts X-Forwarded-*).
AUTH_TRUST_HOST=

# Each provider is enabled only when its full pair of variables is set. The
# app boots with none configured and shows "no auth providers configured".
# GitHub OAuth app: callback URL = http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Google OAuth client: redirect URI = http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Email magic links via Resend. AUTH_EMAIL_FROM must be a verified sender.
AUTH_RESEND_KEY=
AUTH_EMAIL_FROM=
# Local development only: "true" adds a "Dev login" button on /login that
# signs in a local user without any provider. Ignored in production.
AUTH_DEV_LOGIN=true

# --- Worker ----------------------------------------------------------------
# Daily snapshot job (pg-boss, 5-field cron, UTC). Manual run: pnpm worker:run-once
SNAPSHOT_CRON="0 3 * * *"
# Max per-run drift of each store's revenue/traffic, in percent (±).
SNAPSHOT_MAX_DRIFT_PCT=5

# --- Rate limiting (needs REDIS_URL; no-ops without it) --------------------
# Requests per window per client IP on public API routes (/api/stores*, /api/ads*).
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_SECONDS=60

# --- Redis (optional) ------------------------------------------------------
# Upstash (rediss://...) or local. When unset or unreachable, caching and
# rate limiting no-op. Local: docker compose --profile redis up -d
#   REDIS_URL=redis://localhost:6379
REDIS_URL=

# --- Data source -----------------------------------------------------------
# Selects the repository implementation (Phase 2). mock | shopify
DATA_SOURCE=mock

# --- MCP server ------------------------------------------------------------
# MCP has no session; save_to_folder uses this user unless userId is passed.
# Find your id in Prisma Studio (User table) or via the dev user "dev@synergilon.local".
MCP_USER_ID=

# --- Chat ------------------------------------------------------------------
# Vercel AI SDK. AI_PROVIDER=anthropic|openai; the matching key must be set or
# /chat shows a disabled state. AI_MODEL overrides the default model
# (anthropic: claude-opus-5, openai: gpt-5).
AI_PROVIDER=anthropic
AI_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
