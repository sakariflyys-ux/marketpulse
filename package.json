{
  "name": "synergilon",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md,css,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,md,css,yml,yaml}\"",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @synergilon/db generate",
    "db:migrate": "pnpm --filter @synergilon/db migrate:dev",
    "db:deploy": "pnpm --filter @synergilon/db migrate:deploy",
    "db:reset": "pnpm --filter @synergilon/db migrate:reset",
    "db:seed": "pnpm --filter @synergilon/db seed",
    "db:studio": "pnpm --filter @synergilon/db studio",
    "web:dev": "pnpm --filter @synergilon/web dev",
    "worker:dev": "pnpm --filter @synergilon/worker dev",
    "worker:run-once": "pnpm --filter @synergilon/worker run-once",
    "mcp:dev": "pnpm --filter @synergilon/mcp-server dev",
    "test": "turbo run test"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.10.12",
    "typescript": "6.0.3",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "prisma",
      "esbuild",
      "unrs-resolver"
    ]
  }
}
